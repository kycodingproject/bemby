# Copy to .env.local and fill in. Leave Supabase blank to run with demo data.

# Claude (AI replies). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model overrides
# BEMBY_CHAT_MODEL=claude-haiku-5-5
# BEMBY_VISION_MODEL=claude-sonnet-5-5

# Supabase (database, sign-in, photo storage). https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 to force demo data even when Supabase is configured
# BEMBY_DEMO=1

# Twilio (dedicated numbers + texting). https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The public URL of this site, used to verify Twilio webhooks (e.g. https://bemby.vercel.app)
PUBLIC_BASE_URL=

# Password for the whole dashboard until sign-in ships (any username works)
SITE_PASSWORD=

# Meta (Instagram + Messenger). developers.facebook.com
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Any random phrase; paste the same value into the Meta webhook setup
META_VERIFY_TOKEN=

# Stripe (billing). dashboard.stripe.com -> Developers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shown on /privacy, /terms and /data-deletion
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_STATE=California
